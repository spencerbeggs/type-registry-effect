{
	"name": "type-registry-effect",
	"version": "1.1.0",
	"private": true,
	"description": "TypeScript virtual file systems for Effect: fetch, cache and resolve type definitions from npm via the jsDelivr CDN, and build @typescript/vfs environments for Twoslash-style documentation tooling.",
	"keywords": ["typescript", "vfs", "twoslash", "types", "jsdelivr", "cache", "effect"],
	"homepage": "https://github.com/spencerbeggs/type-registry-effect#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/type-registry-effect/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/type-registry-effect.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --passWithNoTests",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/semver": "^0.1.0",
		"@effected/store": "^0.1.0",
		"@effected/xdg": "^0.1.3",
		"@savvy-web/bundler": "^2.0.3",
		"@savvy-web/silk": "^3.0.3",
		"@types/node": "catalog:silk",
		"@typescript/vfs": "^1.6.4",
		"@vitest-agent/plugin": "^2.0.1",
		"effect": "catalog:effect",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:effectPeers",
		"@effected/semver": "^0.1.0",
		"@effected/store": "^0.1.0",
		"@effected/xdg": "^0.1.3",
		"@typescript/vfs": "^1.6.4",
		"effect": "catalog:effectPeers",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"@typescript/vfs": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.5.0",
				"onFail": "ignore"
			}
		]
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": "@spencerbeggs/type-registry-effect"
		}
	}
}
